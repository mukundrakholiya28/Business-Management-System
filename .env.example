# ==============================================================================
# Cars - Business Management System
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and replace with your real values.
# Do NOT commit `.env` or `.env.local` with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Workshop Profile Defaults (Optional - overrides in database profile take precedence)
# ------------------------------------------------------------------------------
COMPANY_PHONE=XXXXXXXXXX
COMPANY_EMAIL=contact@example.com
COMPANY_GSTIN=
PAYMENT_METHODS=UPI / Bank Transfer / Cash
UPI_ID=
BANK_NAME=
ACCOUNT_NUMBER=
IFSC=
