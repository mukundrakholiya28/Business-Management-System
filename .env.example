# ==============================================================================
# Shree Royal Car - Business Management System
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and replace with your real values.
# Do NOT commit `.env` or `.env.local` with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Email Delivery Configuration (Optional - for emailing invoices)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Shree Royal Car <billing@yourdomain.com>

# Option B: Custom SMTP (e.g. Gmail / Outlook / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Shree Royal Car <your-email@gmail.com>

# ------------------------------------------------------------------------------
# 3. WhatsApp Integration (Optional - for automated customer notifications)
# ------------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ------------------------------------------------------------------------------
# 4. Workshop Profile Defaults (Optional - overrides in database profile take precedence)
# ------------------------------------------------------------------------------
COMPANY_PHONE=+91 98765 43210
COMPANY_EMAIL=billing@shreeroyalcar.in
COMPANY_GSTIN=
PAYMENT_METHODS=UPI / Bank Transfer / Cash
UPI_ID=
BANK_NAME=
ACCOUNT_NUMBER=
IFSC=
